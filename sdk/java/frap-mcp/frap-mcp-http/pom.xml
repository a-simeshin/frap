<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.kotler-dev</groupId>
        <artifactId>frap-mcp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>frap-mcp-http</artifactId>
    <name>Frap MCP Http</name>
    <description>Executable Spring Boot MCP server over streamable-http (webmvc) transport</description>

    <dependencies>
        <dependency>
            <groupId>io.github.kotler-dev</groupId>
            <artifactId>frap-mcp-tools</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>

        <!-- streamable-http MCP server transport (Spring MVC) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>frap-mcp-http</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.github.kotlerdev.frap.mcp.http.HttpApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Run *IT.java integration tests (FrapInlineToolsIT) in the verify phase, so
                the inline tool set is exercised where it is active (http runner,
                frap.io.mode=inline) over the real native frap-core-rpc binary. Mirrors the
                stdio module's failsafe wiring to keep IT semantics consistent across runners.
                Version is managed by spring-boot-starter-parent; we only bind goals.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
